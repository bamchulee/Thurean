# Environment Variables สำหรับ Deploy บน Vercel หรือรันในเครื่อง (.env.local)
# ห้ามนำไฟล์ที่มีค่าจริง (.env.local / data/runtime-config.json) ขึ้น GitHub
# ระบบไม่มีค่าลับเริ่มต้นฝังในโค้ดแล้ว — ค่าที่ติดดาว (*) ต้องตั้งเอง ไม่ตั้งฟีเจอร์นั้นจะใช้ไม่ได้

# 1. Google Sheets (ได้จากการ Deploy โค้ดในโฟลเดอร์ google-apps-script/ เป็น Web App)
GOOGLE_SHEETS_WEBAPP_URL=https://script.google.com/macros/s/YOUR_DEPLOY_ID/exec
# (*) key ที่ได้จากการรันฟังก์ชัน generateApiKey ใน Apps Script
GOOGLE_SHEETS_API_KEY=
GOOGLE_SHEET_VIEW_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit

# 2. LINE Official Account Messaging API
LINE_CHANNEL_ACCESS_TOKEN=YOUR_LONG_LIVED_CHANNEL_ACCESS_TOKEN
# (*) Channel secret ของ Messaging API (คนละตัวกับ LINE Login) ใช้ตรวจว่า webhook มาจาก LINE จริง
LINE_CHANNEL_SECRET=
LINE_ADMIN_USER_ID=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_LINE_LIFF_ID=

# 3. LINE Login (ปุ่มเข้าสู่ระบบด้วย LINE)
LINE_LOGIN_CHANNEL_ID=
# (*) Channel secret จาก LINE Developers Console
LINE_LOGIN_CHANNEL_SECRET=

# 4. โดเมนสาธารณะ (บน Vercel ระบบอ่านจาก VERCEL_PROJECT_PRODUCTION_URL อัตโนมัติหากเว้นว่าง)
NEXT_PUBLIC_BASE_URL=

# 5. ความปลอดภัย
# (*) รหัสเข้าหลังบ้าน /admin — อย่างน้อย 6 หลัก และอย่าใช้เลขที่เดาได้ เช่น เบอร์ร้าน
ADMIN_PIN=
# (*) ข้อความสุ่มยาว 32 ตัวขึ้นไป ใช้เซ็น session ของแอดมินและสมาชิก
#     สร้างได้ด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# 6. ช่องทางไลฟ์สด (ตั้งค่าเสริมได้)
LINE_LIVE_PLATFORM=
LINE_LIVE_URL=
LINE_LIVE_NOTE=
LINE_IS_LIVE_NOW=false
