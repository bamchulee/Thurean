# Environment Variables สำหรับ Deploy บน Vercel หรือรันในเครื่อง (.env.local)
# หมายเหตุ: อย่านำไฟล์ที่มี Token จริง (.env.local / data/runtime-config.json) ขึ้น GitHub สาธารณะ

# 1. Google Sheets Real-time Bridge (ได้จากการ Deploy google-apps-script/Code.gs เป็น Web App)
GOOGLE_SHEETS_WEBAPP_URL=https://script.google.com/macros/s/YOUR_DEPLOY_ID/exec
GOOGLE_SHEET_VIEW_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit

# 2. LINE Official Account Messaging API
LINE_CHANNEL_ACCESS_TOKEN=YOUR_LONG_LIVED_CHANNEL_ACCESS_TOKEN
LINE_ADMIN_USER_ID=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_LINE_LIFF_ID=

# 3. โดเมนสาธารณะ (บน Vercel ระบบอ่านจาก VERCEL_PROJECT_PRODUCTION_URL อัตโนมัติหากเว้นว่าง)
NEXT_PUBLIC_BASE_URL=

# 4. ความปลอดภัยหลังบ้าน (/admin)
ADMIN_PIN=2824
ADMIN_SECRET=change-this-to-random-secret-string

# 5. ช่องทางไลฟ์สด (ตั้งค่าเสริมได้)
LINE_LIVE_PLATFORM=
LINE_LIVE_URL=
LINE_LIVE_NOTE=
LINE_IS_LIVE_NOW=false
